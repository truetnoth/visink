  "lines": {
    "advisor.a1": {
      "canvas": "advisor",
      "card": "a1",
      "speaker": "ent_advisor",
      "text": "Ну что, был у декана? # не тег {не условие} [не выбор] // не комментарий -> не переход"
    },
    "advisor.a3": {
      "canvas": "advisor",
      "card": "a3",
      "speaker": "ent_player",
      "text": "Что в архиве?"
    },
    "advisor.a4": {
      "canvas": "advisor",
      "card": "a4",
      "speaker": "ent_player",
      "text": "Кто прислал письмо?"
    },
    "advisor.a5": {
      "canvas": "advisor",
      "card": "a5",
      "speaker": "ent_player",
      "text": "Мне пора."
    },
    "advisor.a6": {
      "canvas": "advisor",
      "card": "a6",
      "speaker": "ent_advisor",
      "text": "Туда пускают только с допуском."
    },
    "advisor.a7": {
      "canvas": "advisor",
      "card": "a7",
      "speaker": "ent_advisor",
      "text": "Без подписи. Странно, правда?"
    },
    "advisor.a9": {
      "canvas": "advisor",
      "card": "a9",
      "speaker": "ent_advisor",
      "text": "Декан на вас зол."
    },
    "dean.c1": {
      "canvas": "dean",
      "card": "c1",
      "speaker": "ent_dean",
      "text": "Садитесь."
    },
    "dean.c2": {
      "canvas": "dean",
      "card": "c2",
      "speaker": "ent_dean",
      "text": "Итак, ваша диссертация?"
    },
    "dean.c3": {
      "canvas": "dean",
      "card": "c3",
      "speaker": "ent_player",
      "text": "Почти готова."
    },
    "dean.c4": {
      "canvas": "dean",
      "card": "c4",
      "speaker": "ent_player",
      "text": "Я сменил тему."
    },
    "dean.c6": {
      "canvas": "dean",
      "card": "c6",
      "emotion": "cold",
      "speaker": "ent_dean",
      "text": "Посмотрим."
    },
    "dean.c7": {
      "canvas": "dean",
      "card": "c7",
      "speaker": "ent_dean",
      "text": "Молчание — тоже ответ."
    }
  },
  "start": "dean.entry_first_meeting",
