{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visink",
  "version": "1.0.1",
  "identifier": "app.visink.editor",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../..",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../..",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Visink",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MEJCRkFFNkJCNUQ2MTUKUldRVjFyVnJycjhMUmxCSG9WMzJBQ2dBKzBWdjRuVzFQQTRWRnp2UEFobUxRVnAyd3F1aUlKTS8K",
      "endpoints": [
        "https://github.com/truetnoth/visink/releases/latest/download/latest.json"
      ]
    }
  }
}
